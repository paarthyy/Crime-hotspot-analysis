# Backend Environment Variables

# JWT Secret for authentication tokens
JWT_SECRET=super_secret_jwt_key_crime_hotspot_2026

# MongoDB Connection String:
# Option 1: MongoDB Atlas (Recommended for cloud/deployment)
# Replace <username>, <password>, and <cluster-url> with your Atlas credentials:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/capstone?retryWrites=true&w=majority

# Option 2: Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/capstone

# Google OAuth Client ID (Get from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Make sure to add authorized origins: http://localhost:5173, http://localhost:5000, and your production domain
GOOGLE_CLIENT_ID=772786124174-83go9s21icd8m5lrqeu28brgfhaiupa1.apps.googleusercontent.com

# Server Port
PORT=5000

# Postgres / PostGIS (Optional - used for police stations distance fallback)
# PG_URI=postgres://postgres:password@localhost:5432/capstone
